# Copy to .env (or set these in your host's dashboard). NEVER commit .env or share these values.

# --- Required ---
NODE_ENV=production
PORT=3000
# Your website address(es), comma separated, no trailing slash. Only these sites may call the API.
SITE_URL=https://www.your-domain.com
# From Google Cloud Console > Credentials > OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# Google emails allowed into /admin, comma separated
ADMIN_EMAILS=you@gmail.com,teammate@gmail.com

# --- Database: PostgreSQL (Supabase) ---
# Supabase dashboard > Connect > copy a connection string and put your database password in it.
# On a host like Render or Railway (which connect over IPv4), use the POOLER string (host ends in pooler.supabase.com).
# Example shape (yours will differ):
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# SSL is on automatically for hosted databases. Set DB_SSL=false only for a local database.
# DB_SSL=false
# Optional: set to true to fully verify the database's SSL certificate (needs your provider's CA certificate)
# DB_SSL_STRICT=true
# Optional: connection pool size (default 10). Keep it small on free plans.
# DB_POOL_MAX=10

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# USD if enabled on your Paystack business, otherwise NGN
CURRENCY=USD
# Only when CURRENCY=NGN: naira per one US dollar
USD_NGN_RATE=0

# --- Cookies and proxy ---
# If the site is www.your-domain.com and the API is api.your-domain.com, leave the defaults.
# Only if they are on completely different domains: COOKIE_SAMESITE=None (needs HTTPS, and some browsers block it)
# COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.your-domain.com
# Set to 1 when running behind a host's load balancer (Render, Railway, Fly), so rate limits use the real visitor address
TRUST_PROXY=1
